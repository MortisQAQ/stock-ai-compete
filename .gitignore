_*.txt
_*.json
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本机产物：Python 虚拟环境与本机脚本
_local/

# 迭代截图与调试脚本（docs/shots 里保存对外引用的版本）
_shots/

# 演示稿工具导出的草稿
draft_*_folder/
