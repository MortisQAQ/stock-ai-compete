# 竞品源码克隆（700MB，别人的仓库）
# 需要时用 scripts/repos_clone.py 或 竞品仓库-本地索引.md 末尾的 clone 命令重建
repos/

# 本地 agent 状态与记忆（含本机路径、环境细节，不入库）
.workbuddy/

# 一次性脚本产出的临时文件
_*.txt
_*.json
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本机产物：Python 虚拟环境与本机脚本
_local/

# 迭代截图与调试脚本（docs/shots 里保存对外引用的版本）
_shots/

# 演示稿工具导出的草稿
draft_*_folder/

# 浏览器取证过程的临时截图与脚本
.tmp-browser/

# 本地临时工作目录：放参考实现的源码（如个人博客原码），对着抄用的，不入库
tmp/

# 历史尝试归档（约 155MB，本地留存，不入库）
_archive/

# 本机取证截图与临时调研草稿
.shots/
.tmp-research/

# 一次性浏览器探针脚本
openoutcry-web/scripts/_*.mjs
